# Copie este arquivo para .env e preencha com os dados do seu PostgreSQL local.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
# Exemplo padrão (instalação local do PostgreSQL no Windows/Linux/Mac):
#   usuário: postgres
#   senha:   a que você definiu no instalador
#   host:    localhost
#   porta:   5432
#   banco:   mercado_pro

DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/mercado_pro
